<?xml version="1.0" encoding="utf-8"?>
<!-- Same emerald gradient as the in-app tap circle, so the bubble reads as
     the app rather than as a generic floating widget. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:startColor="@color/widget_gradient_start"
        android:endColor="@color/widget_gradient_end"
        android:angle="315" />
    <stroke
        android:width="2dp"
        android:color="#4DFFFFFF" />
</shape>
